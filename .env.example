# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=tbd
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=tbd

# KI-Textgenerierung (Anthropic)
ANTHROPIC_API_KEY=tbd

# E-Mail (Resend)
RESEND_API_KEY=tbd
CONTACT_EMAIL=info@tierphysio-klauser.de

# Website-URL (für Social Share absolute Links)
NEXT_PUBLIC_SITE_URL=https://tierphysio-klauser.de

# Optional: Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=tbd

# ── Telegram Bot (Phase 2) ────────────────────────────────────────────────────
# @BotFather → /newbot → Token hier eintragen
TELEGRAM_BOT_TOKEN=tbd
# Komma-getrennte Telegram-User-IDs, die den Bot nutzen dürfen (z.B. Saras ID)
TELEGRAM_ALLOWED_USER_IDS=tbd
# Optional: Zufälliger String zum Absichern des Webhooks
TELEGRAM_WEBHOOK_SECRET=tbd

# ── Cloudinary (Bildverarbeitung) ─────────────────────────────────────────────
# https://cloudinary.com → kostenloses Konto → Dashboard → Credentials
CLOUDINARY_CLOUD_NAME=tbd
CLOUDINARY_API_KEY=tbd
CLOUDINARY_API_SECRET=tbd

# ── Upstash Redis (Bot-Session-Speicher) ──────────────────────────────────────
# https://upstash.com → Redis erstellen → REST API Keys kopieren
UPSTASH_REDIS_REST_URL=tbd
UPSTASH_REDIS_REST_TOKEN=tbd

# ── Bot-Inhalte ───────────────────────────────────────────────────────────────
# Saras Telefonnummer für CTA-Texte
SARA_PHONE=+49 XXXX XXXXXXX

# ── Instagram (optional, für automatisches Posting) ───────────────────────────
# https://developers.facebook.com → Meta App → Instagram Graph API
# Erfordert Instagram Business Account + Meta Developer App
INSTAGRAM_ACCESS_TOKEN=tbd
INSTAGRAM_USER_ID=tbd

# ── Facebook (optional, für automatisches Posting) ────────────────────────────
# https://developers.facebook.com → Meta App → Facebook Page API
FACEBOOK_PAGE_ACCESS_TOKEN=tbd
FACEBOOK_PAGE_ID=tbd
